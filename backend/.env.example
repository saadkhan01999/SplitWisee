# SplitWisee API — environment template.
# Development: copy to backend/.env (npm run dev loads it). Production: set these in the host environment
# (systemd EnvironmentFile, Docker --env-file, or your platform's secret manager). Never commit real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────────────────────
# development | production. Production enables Secure __Host- cookies and refuses to start without an HTTPS
# APP_ORIGIN, SMTP, configured Stripe billing with BILLING_ENFORCED=true and RECEIPT_DIR.
NODE_ENV=development
PORT=5000
# Interface to listen on. Use 127.0.0.1 on a VPS behind Nginx; 0.0.0.0 inside Docker.
HOST=0.0.0.0
# The public origin users open in the browser (where the frontend is served). Development: the Vite dev server.
# Production example: https://app.example.com  (no path, no trailing slash)
APP_ORIGIN=http://localhost:5173
# Only if the API is on a different subdomain than the frontend (e.g. https://api.example.com). Leave empty when
# Nginx serves the frontend and proxies /api on the same domain (recommended).
API_ORIGIN=
# Only for a separate API subdomain: comma-separated frontend origins allowed to call the API with credentials.
CORS_ORIGINS=
# Number of trusted reverse proxies in front of Node (Nginx = 1, none = 0).
TRUST_PROXY_HOPS=0

# ── MongoDB (replica set required; MongoDB Atlas clusters are replica sets) ──────────────
# Paste your Atlas connection string here. URL-encode the password (@ -> %40, : -> %3A, / -> %2F).
# The server refuses to start while this placeholder is unchanged.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/?retryWrites=true&w=majority&appName=SplitWisee
# Database name; keep environments separate (splitwisee, splitwisee_staging, splitwisee_dev).
MONGODB_DB=splitwisee_dev

# ── Private receipt storage ───────────────────────────────────────────────────────────────
# Original receipt files. Production: an ABSOLUTE, persistent, backed-up path outside the code, e.g. /srv/splitwisee/receipts
RECEIPT_DIR=./private-receipts

# ── Email (verification and password-reset codes) ─────────────────────────────────────────
# Development only: when SMTP_HOST is empty, print codes in this terminal. Ignored in production.
DEV_SHOW_EMAIL_CODES=true
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. SplitWisee <no-reply@example.com>
EMAIL_FROM=

# ── Optional sign-in providers (leave empty to disable) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Stripe subscriptions (GBP 0.99/month); test-mode keys until production sign-off ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring MONTHLY GBP price of exactly 99 pence (enforced by the API).
STRIPE_PRICE_ID=
# true = paid operations require a subscription or an earned access month (must be true in production).
BILLING_ENFORCED=false

# ── Encryption and platform operator ─────────────────────────────────────────────────────
# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_ENCRYPTION_KEY=
# Exactly ONE verified user ID: the platform owner (shown in the app under Account & settings).
SUPERADMIN_USER_ID=
# JSON map of that user ID to a Base32 authenticator secret, e.g. {"<user-id>":"JBSWY3DPEHPK3PXP..."}
OPERATOR_TOTP_SECRETS={}

# ── Tests only ────────────────────────────────────────────────────────────────────────────
# npm run test:mongodb uses this replica set and creates/drops its own *_test database. Never production.
# MONGODB_TEST_URI=
