# SplitWisee web app — build-time settings. Every VITE_ value is compiled into the public JavaScript bundle,
# so never put secrets here. Copy to .env for local development.

# Public address of the website, without a trailing slash (canonical links, social previews, sitemap.xml).
# Example: https://app.example.com
VITE_SITE_URL=

# Leave empty when the API is served from the same domain under /api (recommended: Nginx proxies /api).
# Only for an API on its own subdomain, e.g. https://api.example.com (then set CORS_ORIGINS on the API).
VITE_API_BASE_URL=

# Development only: where `npm run dev` forwards /api requests (the API's `npm run dev`). Use 127.0.0.1, not
# localhost: Node may resolve localhost to IPv6 (::1) while the API listens on IPv4.
VITE_DEV_API_PROXY=http://127.0.0.1:5000
