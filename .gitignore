# Dependencies (each package installs its own)
node_modules/

# Secrets: only the .env.example templates are committed
.env
.env.*
!.env.example

# Private runtime data: uploaded receipts never belong in the repository
private-receipts/

# Build output (frontend: npm run build creates dist/ on the build machine)
dist/
coverage/

# Vercel CLI project link and local build output
.vercel/

# Logs and local reports
*.log
/preflight*.json
backend/preflight*.json

docs/
deploy/
CHANGELOG.md