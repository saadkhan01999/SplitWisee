{
  "name": "splitwisee-backend",
  "version": "1.3.0",
  "description": "SplitWisee REST API (Express 5 + MongoDB).",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:mongodb": "node --test tests/mongodb.integration.test.js",
    "db:init": "node --env-file-if-exists=.env database/init.js",
    "preflight": "node scripts/preflight.js",
    "routes": "node scripts/list-routes.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.1.0",
    "mongodb": "^6.16.0",
    "nodemailer": "^10.1.1",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0"
  }
}
